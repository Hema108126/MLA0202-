        "\n",
        "import pandas as pd\n",
        "import math\n",
        "from collections import Counter\n",
        "\n",
        "# Play Tennis dataset\n",
        "data = {\n",
        "    'Outlook': ['Sunny','Sunny','Overcast','Rain','Rain','Rain',\n",
        "                'Overcast','Sunny','Sunny','Rain','Sunny','Overcast',\n",
        "                'Overcast','Rain'],\n",
        "    'Temperature': ['Hot','Hot','Hot','Mild','Cool','Cool','Cool',\n",
        "                    'Mild','Cool','Mild','Mild','Mild','Hot','Mild'],\n",
        "    'Humidity': ['High','High','High','High','Normal','Normal','Normal',\n",
        "                 'High','Normal','Normal','Normal','High','Normal','High'],\n",
        "    'Wind': ['Weak','Strong','Weak','Weak','Weak','Strong','Strong',\n",
        "             'Weak','Weak','Weak','Strong','Strong','Weak','Strong'],\n",
        "    'PlayTennis': ['No','No','Yes','Yes','Yes','No','Yes',\n",
        "                   'No','Yes','Yes','Yes','Yes','Yes','No']\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "print(\"Dataset:\")\n",
        "print(df)\n",
        "\n",
        "# Calculate entropy\n",
        "def entropy(labels):\n",
        "    counts = Counter(labels)\n",
        "    total = len(labels)\n",
        "    return -sum((count/total) * math.log2(count/total)\n",
        "                for count in counts.values())\n",
        "\n",
        "# Calculate information gain\n",
        "def information_gain(df, attribute, target):\n",
        "    total_entropy = entropy(df[target])\n",
        "    weighted_entropy = 0\n",
        "\n",
        "    for value in df[attribute].unique():\n",
        "        subset = df[df[attribute] == value]\n",
        "        weighted_entropy += (len(subset)/len(df)) * entropy(subset[target])\n",
        "\n",
        "    return total_entropy - weighted_entropy\n",
        "\n",
        "# Build ID3 decision tree\n",
        "def id3(df, target, attributes):\n",
        "    if len(df[target].unique()) == 1:\n",
        "        return df[target].iloc[0]\n",
        "\n",
        "    if not attributes:\n",
        "        return df[target].mode()[0]\n",
        "\n",
        "    gains = {attr: information_gain(df, attr, target)\n",
        "             for attr in attributes}\n",
        "    best = max(gains, key=gains.get)\n",
        "\n",
        "    tree = {best: {}}\n",
        "\n",
        "    for value in df[best].unique():\n",
        "        subset = df[df[best] == value]\n",
        "\n",
        "        if subset.empty:\n",
        "            tree[best][value] = df[target].mode()[0]\n",
        "        else:\n",
        "            remaining = [a for a in attributes if a != best]\n",
        "            tree[best][value] = id3(subset, target, remaining)\n",
        "\n",
        "    return tree\n",
        "\n",
        "# Classify a new sample\n",
        "def predict(tree, sample):\n",
        "    if not isinstance(tree, dict):\n",
        "        return tree\n",
        "\n",
        "    attribute = next(iter(tree))\n",
        "    value = sample.get(attribute)\n",
        "\n",
        "    if value not in tree[attribute]:\n",
        "        return \"Unknown\"\n",
        "\n",
        "    return predict(tree[attribute][value], sample)\n",
        "\n",
        "# Build the tree\n",
        "attributes = list(df.columns[:-1])\n",
        "tree = id3(df, 'PlayTennis', attributes)\n",
        "\n",
        "print(\"\\nDecision Tree:\")\n",
        "print(tree)\n",
        "\n",
        "# New sample\n",
        "sample = {\n",
        "    'Outlook': 'Sunny',\n",
        "    'Temperature': 'Cool',\n",
        "    'Humidity': 'High',\n",
        "    'Wind': 'Strong'\n",
        "}\n",
        "\n",
        "print(\"\\nNew Sample:\", sample)\n",
        "print(\"Prediction:\", predict(tree, sample))\n"
      ]
