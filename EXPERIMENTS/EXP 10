        "# Expectation-Maximization Algorithm\n",
        "import numpy as np\n",
        "from sklearn.mixture import GaussianMixture\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Dataset\n",
        "X = np.array([\n",
        "    [1], [2], [3], [4], [5],\n",
        "    [10], [11], [12], [13], [14]\n",
        "])\n",
        "\n",
        "# Apply EM algorithm\n",
        "model = GaussianMixture(\n",
        "    n_components=2, random_state=42, n_init=5\n",
        ")\n",
        "model.fit(X)\n",
        "\n",
        "# Predict clusters\n",
        "labels = model.predict(X)\n",
        "\n",
        "# Display results\n",
        "print(\"Cluster Labels:\", labels)\n",
        "print(\"Cluster Means:\\n\", model.means_)\n",
        "print(\"Cluster Probabilities:\\n\", model.predict_proba(X))\n",
        "\n",
        "# Plot clusters\n",
        "plt.scatter(X[:, 0], np.zeros(len(X)), c=labels)\n",
        "plt.xlabel(\"Data Values\")\n",
        "plt.title(\"Expectation-Maximization Clustering\")\n",
        "plt.show()"
      ]
    }
